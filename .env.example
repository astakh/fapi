# Пример файла .env
# Скопируйте этот файл в .env и заполните реальными значениями.

# Строка подключения к PostgreSQL через asyncpg
# Формат: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/todo_db

# Секретный ключ (используйте случайную строку в продакшене)
SECRET_KEY=change-me-to-random-string

# Режим отладки (true/false)
DEBUG=true
